#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
#  local-file-sharer · run straight from a checkout
#
#    git clone https://github.com/Erawat4l/local-file-sharer.git
#    cd local-file-sharer
#    ./run install      then `lfs` from anywhere
#
#  First run creates .venv, installs the package into it in editable mode, then
#  starts lfs. Every run after that goes straight to lfs — no install step, no
#  checkout of anything, no network unless rich/qrcode are missing.
#
#  Because the install is editable, upgrading is just `git pull`:
#
#    git pull && ./run
#
#  Commands
#    ./run              set up if needed, then start lfs
#    ./run setup        set up only (useful in a script)
#    ./run upgrade      git pull, then re-run setup
#    ./run doctor       set up, then run `lfs doctor`
#    ./run install      set up and put lfs on PATH (the install command)
#    ./run --help       this text
#    ./run <anything>   passed straight to lfs, e.g. ./run ~/Downloads --mode serve
#
#  Nothing here touches your system Python: pip, rich and qrcode all live inside
#  .venv, so an uninstall is `rm -rf .venv` and your device is unchanged.
# ─────────────────────────────────────────────────────────────────────────────
set -eu

# Resolve symlinks, or `ln -s ~/lfs/run ~/bin/lfs` builds .venv inside ~/bin.
# Portable: no readlink -f, which macOS lacks.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self") || break
    case $link in
        /*) self=$link ;;
        *)  self=${self%/*}/$link ;;
    esac
done
case $self in
    */*) HERE=$(CDPATH= cd -- "${self%/*}" && pwd) ;;
    *)   HERE=$(pwd) ;;
esac
cd "$HERE" || exit 1

# Termux has no /tmp, so error capture needs a directory that exists there.
# Cache inside the checkout: removable, and it is already gitignored.
SCRATCH="$HERE/.lfs-tmp"
mkdir -p "$SCRATCH" 2>/dev/null || SCRATCH="${TMPDIR:-$HERE}"
VENV="$HERE/.venv"
PY="$VENV/bin/python"
LFS="$VENV/bin/lfs"
BRANCH="${LFS_BRANCH:-main}"
OWNER="Erawat4l"          # ends with a lowercase L, not a digit
REPO="local-file-sharer"

# ── tiny output helpers ─────────────────────────────────────────────────────
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    B=$(printf '\033[1m'); D=$(printf '\033[2m'); G=$(printf '\033[32m')
    Y=$(printf '\033[33m'); R=$(printf '\033[31m'); N=$(printf '\033[0m')
else
    B=""; D=""; G=""; Y=""; R=""; N=""
fi
say()  { printf '%s\n' "$*"; }
step() { printf '%s→%s %s\n' "$D" "$N" "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*"; }
die()  { printf '%s✗%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

# pip downloads for a minute and, because it is run quietly so its chatter does
# not bury the three lines that matter, the terminal sat frozen on one step.
# This draws a bar in its place while the command runs and erases it after, so
# the scrollback stays clean.
TTY=0
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then TTY=1; fi
spin() {
    # spin <pid> <ready-file> <label>
    #   The job writes its exit code to <ready-file> as its very last act, so
    #   the bar stops exactly when the work does. Polling `kill -0` instead
    #   would spin forever: a finished but unreaped child still has a pid.
    _pid=$1; _ready=$2; _label=${3:-working}; _i=0
    if [ "$TTY" != 1 ]; then wait "$_pid" 2>/dev/null || true; return 0; fi
    while [ ! -f "$_ready" ]; do
        _f=$(( _i % 11 )); _e=$(( 10 - _f ))
        _on=$(printf '%*s' "$_f" '' | tr ' ' '#')
        _off=$(printf '%*s' "$_e" '' | tr ' ' '-')
        printf '\r%s[%s%s]%s %s' "$D" "$_on" "$_off" "$N" "$_label"
        _i=$(( _i + 1 ))
        sleep 0.2 2>/dev/null || sleep 1
        kill -0 "$_pid" 2>/dev/null || break
    done
    wait "$_pid" 2>/dev/null || true
    printf '\r\033[K'
}

usage() {
    # the header comment is the help text: keep one copy of the truth
    if command -v sed >/dev/null 2>&1; then
        sed -n '2,33p' "$self" | sed 's/^# \{0,1\}//'
    else
        printf '%s\n' "local-file-sharer: cd into the checkout and run ./run"
    fi
    exit 0
}

# ── 1. find a Python that can build a venv ──────────────────────────────────
find_python() {
    for candidate in python3 python; do
        command -v "$candidate" >/dev/null 2>&1 || continue
        # Version and the venv module only. ensurepip and pip are deliberately
        # NOT required here: setup() knows how to work without them (Termux
        # ships neither with `python`), and requiring them here meant a working
        # interpreter was reported as missing.
        if "$candidate" -c 'import sys, venv; sys.exit(0 if sys.version_info >= (3, 9) else 1)' \
            >/dev/null 2>&1; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    return 1
}

need_python() {
    if py=$(find_python); then
        return 0
    fi
    printf '\n' >&2
    die "no Python 3.9+ with venv support found.
  Termux : pkg install python
  Debian : sudo apt install python3 python3-venv
  Fedora : sudo dnf install python3
  macOS  : brew install python3   (or install the Xcode command line tools)"
}

# ── 2. set up the virtualenv ────────────────────────────────────────────────
# A cheap way to tell Termux apart from any other Linux: it sets $PREFIX to its
# own root, and ships `pkg` there.
is_termux() {
    case "${PREFIX:-}" in
        *com.termux*) return 0 ;;
    esac
    command -v pkg >/dev/null 2>&1 && [ -n "${ANDROID_ROOT:-}" ]
}

# Termux splits its Python up: the `python` package has venv but NOT pip, and
# `python-pip` provides pip separately. Without it there is no ensurepip and no
# pip, so a virtualenv cannot be bootstrapped by the usual route.
termux_install_pip() {
    is_termux || return 1
    [ -z "${LFS_NO_AUTOINSTALL:-}" ] || return 1
    command -v pkg >/dev/null 2>&1 || return 1
    # Already there? `pkg install` succeeding is not proof the interpreter can
    # see pip, so ask the interpreter. Reporting "pip installed" while pip is
    # still missing is how this went round in circles before.
    if system_has_pip; then
        return 1
    fi
    step "Termux keeps pip in a separate package — installing python-pip"
    if pkg install -y python-pip >"$SCRATCH"/pkg-out 2>&1; then
        if system_has_pip; then
            ok "pip installed"
            return 0
        fi
        warn "python-pip is installed, but this Python still cannot import pip"
        return 1
    fi
    warn "could not install python-pip automatically:"
    tail -3 "$SCRATCH"/pkg-out 2>/dev/null | sed 's/^/    /' >&2 || true
    return 1
}

# Is there a working pip inside the venv? An interrupted or failed venv leaves
# .venv/bin/python behind with no pip, and reusing that fails later with the
# unhelpful "No module named pip".
venv_has_pip() {
    [ -x "$PY" ] && "$PY" -m pip --version >/dev/null 2>&1
}

# A Python whose own C extensions cannot load is a broken install: pyexpat is
# linked against libexpat, and if that library is older than the interpreter
# expects, importing it fails with
#   ImportError: dlopen failed: cannot locate symbol "XML_GetCurrentLineNumber64"
# Every later step then fails too, from deep inside pip, which is unreadable.
broken_stdlib() {
    if "$py" - <<'PYEOF' >"$SCRATCH"/stdlib 2>&1
import importlib
for name in ("pyexpat", "zlib", "sqlite3", "ssl", "_ctypes", "ctypes"):
    try:
        importlib.import_module(name)
    except Exception as exc:  # noqa: BLE001 - any failure here is fatal to pip
        raise SystemExit(f"{name}: {type(exc).__name__}: {exc}")
PYEOF
    then
        return 1   # imports fine
    fi
    return 0       # broken
}

# pip, but only reachable from outside the venv (system site-packages).
system_has_pip() {
    "$py" -m pip --version >/dev/null 2>&1
}

# Last resort: pip runs, but only from outside the venv.
bootstrap_pip() {
    if "$PY" -m ensurepip --upgrade >"$SCRATCH"/bootstrap 2>&1; then
        return 0
    fi
    # A pip outside the venv can be used by the venv python (it installs into
    # the venv, not into the system), so ask it to upgrade itself in place.
    if "$py" -m pip --version >/dev/null 2>&1; then
        if "$PY" -m pip --version >/dev/null 2>&1; then
            return 0
        fi
    fi
    # No pip anywhere. get-pip.py needs nothing but the standard library.
    if [ -f "$SCRATCH/get-pip.py" ] || fetch_get_pip; then
        if "$PY" "$SCRATCH/get-pip.py" >>"$SCRATCH"/bootstrap 2>&1; then
            return 0
        fi
    fi
    return 1
}

# Download get-pip.py with whatever this device has. python itself can do it, so
# a missing curl is not fatal; curl/wget are tried after it because Termux has
# its own CA bundle wired into them.
fetch_get_pip() {
    url="https://bootstrap.pypa.io/get-pip.py"
    for tool in "$py" curl wget; do
        case $tool in
            "$py"|python*)
                "$py" - "$url" "$SCRATCH/get-pip.py" >"$SCRATCH"/fetch 2>&1 <<'PYEOF' && return 0
import sys, urllib.request
url, dest = sys.argv[1], sys.argv[2]
with urllib.request.urlopen(url, timeout=30) as r, open(dest, "wb") as f:
    f.write(r.read())
PYEOF
                ;;
            curl)
                command -v curl >/dev/null 2>&1 || continue
                curl -fsSL "$url" -o "$SCRATCH/get-pip.py" >"$SCRATCH"/fetch 2>&1 && return 0
                ;;
            wget)
                command -v wget >/dev/null 2>&1 || continue
                wget -q "$url" -O "$SCRATCH/get-pip.py" >"$SCRATCH"/fetch 2>&1 && return 0
                ;;
        esac
    done
    return 1
}

# Every way of making a venv. Ordered so the normal case stays clean and fast:
# a healthy Python gets an ordinary venv, and only a failure moves us down the
# list. Each attempt appends to one log, so a total failure shows every real
# error instead of a stock guess about which one it was.
make_venv() {
    : >"$SCRATCH"/venv-out

    try_venv() {
        printf '· %s\n' "$*" >>"$SCRATCH"/venv-out
        "$@" >>"$SCRATCH"/venv-out 2>&1 && [ -x "$PY" ]
    }

    # 1. The ordinary venv. Fails on Termux, where `venv` calls ensurepip and
    #    ensurepip exits 1 ("ensurepip ... returned non-zero exit status 1").
    rm -rf "$VENV"
    if try_venv "$py" -m venv "$VENV" && venv_has_pip; then
        return 0
    fi

    # 2. pip exists outside the venv: borrow it. The venv imports the system
    #    pip and installs into its own site-packages.
    if system_has_pip; then
        rm -rf "$VENV"
        if try_venv "$py" -m venv --without-pip --system-site-packages "$VENV" && venv_has_pip; then
            return 0
        fi
    fi

    # 3. No pip anywhere: make a bare venv; setup() bootstraps pip into it.
    rm -rf "$VENV"
    if try_venv "$py" -m venv --without-pip "$VENV"; then
        return 0
    fi

    # 4. virtualenv carries its own wheels and never touches ensurepip.
    if command -v virtualenv >/dev/null 2>&1; then
        rm -rf "$VENV"
        try_venv virtualenv --no-download "$VENV" && return 0
        rm -rf "$VENV"
        try_venv virtualenv "$VENV" && return 0
    fi
    return 1
}

setup() {
    need_python

    # Fail here, with a sentence a person can act on, rather than 64 lines into
    # a pip traceback about a library none of this code names.
    if broken_stdlib; then
        detail=$(cat "$SCRATCH"/stdlib 2>/dev/null || true)
        rm -f "$SCRATCH"/stdlib
        case "$detail" in
            *pyexpat*|*XML_*)
                printf '%s\n' "✗ this Python's XML extension cannot load — its libexpat does not match." >&2
                printf '%s\n' "    $detail" >&2
                printf '%s\n' "" >&2
                printf '%s\n' "  Termux: the libexpat and python packages are out of step." >&2
                printf '%s\n' "      pkg update && pkg upgrade" >&2
                printf '%s\n' "      pkg install --reinstall libexpat python" >&2
                printf '%s\n' "  If that does not fix it, a foreign repository may be shadowing" >&2
                printf '%s\n' "  the official one:  pkg list-installed | grep expat" >&2
                exit 1 ;;
            *dlopen*|*"cannot locate symbol"*|*"undefined symbol"*)
                printf '%s\n' "✗ this Python's own libraries are broken, so pip cannot run." >&2
                printf '%s\n' "    $detail" >&2
                printf '%s\n' "" >&2
                printf '%s\n' "  Termux: pkg update && pkg upgrade" >&2
                printf '%s\n' "          pkg install --reinstall python" >&2
                exit 1 ;;
            *)
                printf '%s\n' "✗ this Python is missing a standard module, so pip cannot run." >&2
                printf '%s\n' "    $detail" >&2
                printf '%s\n' "" >&2
                printf '%s\n' "  Termux: pkg install --reinstall python" >&2
                exit 1 ;;
        esac
    fi
    rm -f "$SCRATCH"/stdlib

    # A venv that cannot pip is not a venv. Remake it rather than failing in a
    # later step with "No module named pip".
    if [ -d "$VENV" ] && ! venv_has_pip; then
        warn "found a broken .venv (no pip) — recreating it"
        rm -rf "$VENV"
    fi

    if [ ! -x "$PY" ]; then
        step "creating .venv with $("$py" --version 2>&1)"
        if ! make_venv; then
            # No pip and no ensurepip: on Termux that is one package away.
            if termux_install_pip && make_venv; then
                :
            else
                msg=$(tail -n 8 "$SCRATCH"/venv-out 2>/dev/null || true)
                {
                    printf '%s\n' "could not create .venv — the attempts made were:"
                    printf '%s\n' "$msg" | sed 's/^/    /'
                    printf '\n'
                    if is_termux; then
                        # Only offer the package if this interpreter cannot
                        # already see pip: telling someone to install what they
                        # just installed is the loop this got stuck in.
                        if system_has_pip; then
                            printf '%s\n' "  pip is installed but unusable. Either:"
                            printf '%s\n' "      pkg install --reinstall python-pip"
                            printf '%s\n' "  or bypass ensurepip entirely:"
                            printf '%s\n' "      pkg install virtualenv"
                        else
                            printf '%s\n' "  Termux keeps pip in its own package:"
                            printf '%s\n' "      pkg install python-pip"
                        fi
                        printf '%s\n' "  then:"
                        printf '%s\n' "      rm -rf .venv && ./run"
                    else
                        printf '%s\n' "  Debian : sudo apt install python3-venv python3-pip"
                        printf '%s\n' "  Fedora : sudo dnf install python3"
                        printf '%s\n' "  macOS  : brew install python3"
                    fi
                } >&2
                exit 1
            fi
        fi
        rm -f "$SCRATCH"/venv-out "$SCRATCH"/venv-probe
        ok "created .venv"
    fi

    # Still no pip after all that (a venv made earlier by another tool, or one
    # built with --without-pip). Fix it here, where the message is honest.
    if ! venv_has_pip; then
        step "no pip inside .venv — bootstrapping it"
        if ! bootstrap_pip; then
            # Termux: one package install, then the borrow path works.
            if termux_install_pip; then
                rm -rf "$VENV"
                step "rebuilding .venv with the freshly installed pip"
                if make_venv && bootstrap_pip; then
                    :
                fi
            fi
        fi
        if ! venv_has_pip; then
            msg=$(tail -n 8 "$SCRATCH"/bootstrap 2>/dev/null || true)
            {
                printf '%s\n' "the virtualenv has no pip and it could not be bootstrapped."
                printf '%s\n' "$msg" | sed 's/^/    /'
                if is_termux; then
                    printf '%s\n' "  try:  pkg install python-pip virtualenv"
                    printf '%s\n' "  then: rm -rf .venv && ./run"
                fi
            } >&2
            exit 1
        fi
        ok "pip ready"
    fi

    # Editable install, so `git pull` is the whole upgrade path. Re-run only
    # when something actually changed: a fresh checkout, or a commit that
    # touched the packaging metadata.
    stamp="$VENV/.lfs-stamp"
    want=$(git -C "$HERE" rev-parse --short HEAD 2>/dev/null || echo "nogit")
    if [ -x "$LFS" ] && [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$want" ]; then
        return 0
    fi

    step "installing dependencies (rich, qrcode)"
    "$PY" -m pip install --quiet --upgrade pip >/dev/null 2>&1 || true
    rm -f "$SCRATCH"/pip-rc
    ( "$PY" -m pip install --quiet --editable "$HERE" 2>"$SCRATCH"/pip-error
      printf '%s' "$?" > "$SCRATCH"/pip-rc ) &
    _pip=$!
    spin "$_pip" "$SCRATCH"/pip-rc "downloading rich + qrcode"
    if [ "$(cat "$SCRATCH"/pip-rc 2>/dev/null || echo 1)" != 0 ]; then
        msg=$(cat "$SCRATCH"/pip-error 2>/dev/null || true)
        rm -f "$SCRATCH"/pip-error
        case "$msg" in
            *"Could not find a version"*|*"Temporary failure"*|*"Name or service"*)
                die "cannot reach PyPI — check the connection and run ./run again" ;;
            "")
                die "pip failed without printing anything. Run it directly to see why:
  $PY -m pip install --editable $HERE" ;;
        esac
        printf '%s\n' "$msg" >&2
        die "install failed (full output above)"
    fi
    rm -f "$SCRATCH"/pip-error
    printf '%s' "$want" > "$stamp"
    ok "installed $("$PY" -c 'import local_file_sharer as m; print(m.__version__)')"
}

# ── 3. dispatch ─────────────────────────────────────────────────────────────
case "${1:-}" in
    -h|--help|help) usage ;;
    setup)    setup; say ""; ok "ready — run ./run"; exit 0 ;;
    upgrade)
        setup
        # This directory may be a git clone, or a copy unpacked by
        # install-lfs.py. Only the first can `git pull`; the second used to hit
        # "not a git repository" and die, which made the documented upgrade
        # path impossible for anyone who used the installer.
        if [ -d "$HERE/.git" ]; then
            step "pulling $BRANCH"
            git -C "$HERE" pull --ff-only || die "git pull failed — resolve it, then run ./run"
            rm -f "$VENV/.lfs-stamp"
            setup
            ok "upgraded — run ./run"
            exit 0
        fi
        # No history to pull. All that has to change is the package itself, so
        # reinstall it in place: pip fetches the same branch, and because the
        # install is editable the code that runs is the code just fetched.
        step "this copy was not cloned with git, so there is nothing to pull"
        step "reinstalling from $BRANCH instead"
        "$PY" -m pip install --quiet --upgrade --force-reinstall --no-deps \
            "local-file-sharer @ git+https://github.com/$OWNER/$REPO.git@$BRANCH" \
            2>"$SCRATCH"/upgrade-error || {
                msg=$(cat "$SCRATCH"/upgrade-error 2>/dev/null || true)
                rm -f "$SCRATCH"/upgrade-error
                printf '%s\n' "$msg" >&2
                die "upgrade failed — see above. Nothing was changed."
            }
        rm -f "$SCRATCH"/upgrade-error
        ok "upgraded — run ./run"
        exit 0 ;;
    doctor)   setup; exec "$LFS" doctor ;;
    install|link)
        # Put THIS checkout's lfs on PATH. The usual cause of "the menu is
        # different from the screenshot" is an older `lfs` from a previous
        # install shadowing this one, which `./run` never uses -- it always
        # runs .venv/bin/lfs.
        setup
        bin_dir="${PREFIX:-$HOME}/bin"
        mkdir -p "$bin_dir"
        ln -sf "$LFS" "$bin_dir/lfs"
        ok "linked $bin_dir/lfs → $LFS"
        case ":$PATH:" in
            *":$bin_dir:"*) : ;;
            *) warn "$bin_dir is not on PATH — add it: export PATH=\"$bin_dir:\$PATH\"" ;;
        esac
        say ""
        say "  this copy:  $("$LFS" --version 2>/dev/null | head -1)"

        # Linking into a directory that loses to an earlier copy changes
        # nothing a user can see: they run `lfs`, get the old one, and every
        # fix since looks like it did not ship. So link into the directory
        # their shell actually picks first, when that one is not already ours.
        if other=$(command -v lfs 2>/dev/null) && [ -n "$other" ]; then
            same=$(readlink -f "$other" 2>/dev/null || echo "$other")
            mine=$(readlink -f "$LFS" 2>/dev/null || echo "$LFS")
            if [ "$same" != "$mine" ]; then
                first_dir=$(dirname "$other")
                if [ -w "$first_dir" ]; then
                    ln -sf "$LFS" "$first_dir/lfs"
                    ok "pointed $first_dir/lfs at this copy (it was answering first)"
                    say "  the old file is replaced, not deleted — nothing is lost"
                else
                    warn "another lfs answers your shell first: $other"
                    say "  remove it, then run ./run install again:"
                    say "    rm $other"
                fi
            fi
        fi
        if other=$(command -v lfs 2>/dev/null) && [ -n "$other" ]; then
            if [ "$(readlink -f "$other" 2>/dev/null || echo "$other")" = \
               "$(readlink -f "$LFS" 2>/dev/null || echo "$LFS")" ]; then
                ok "your shell now runs this copy: lfs"
            else
                warn "your shell still runs a different lfs: $other"
            fi
        fi
        exit 0 ;;
    "")       setup; exec "$LFS" ;;
    *)        setup; exec "$LFS" "$@" ;;
esac
