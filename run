#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
#  local-file-sharer · run straight from a checkout
#
#    git clone https://github.com/Erawat4l/local-file-sharer.git
#    cd local-file-sharer
#    ./run
#
#  First run creates .venv, installs the package into it in editable mode, then
#  starts lfs. Every run after that goes straight to lfs — no install step, no
#  checkout of anything, no network unless rich/qrcode are missing.
#
#  Because the install is editable, upgrading is just `git pull`:
#
#    git pull && ./run
#
#  Commands
#    ./run              set up if needed, then start lfs
#    ./run setup        set up only (useful in a script)
#    ./run upgrade      git pull, then re-run setup
#    ./run doctor       set up, then run `lfs doctor`
#    ./run --help       this text
#    ./run <anything>   passed straight to lfs, e.g. ./run ~/Downloads --mode serve
#
#  Nothing here touches your system Python: pip, rich and qrcode all live inside
#  .venv, so an uninstall is `rm -rf .venv` and your device is unchanged.
# ─────────────────────────────────────────────────────────────────────────────
set -eu

# Resolve symlinks, or `ln -s ~/lfs/run ~/bin/lfs` builds .venv inside ~/bin.
# Portable: no readlink -f, which macOS lacks.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self") || break
    case $link in
        /*) self=$link ;;
        *)  self=${self%/*}/$link ;;
    esac
done
case $self in
    */*) HERE=$(CDPATH= cd -- "${self%/*}" && pwd) ;;
    *)   HERE=$(pwd) ;;
esac
cd "$HERE" || exit 1

# Termux has no /tmp, so error capture needs a directory that exists there.
# Cache inside the checkout: removable, and it is already gitignored.
SCRATCH="$HERE/.lfs-tmp"
mkdir -p "$SCRATCH" 2>/dev/null || SCRATCH="${TMPDIR:-$HERE}"
VENV="$HERE/.venv"
PY="$VENV/bin/python"
LFS="$VENV/bin/lfs"
BRANCH="${LFS_BRANCH:-main}"
OWNER="Erawat4l"          # ends with a lowercase L, not a digit
REPO="local-file-sharer"

# ── tiny output helpers ─────────────────────────────────────────────────────
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    B=$(printf '\033[1m'); D=$(printf '\033[2m'); G=$(printf '\033[32m')
    Y=$(printf '\033[33m'); R=$(printf '\033[31m'); N=$(printf '\033[0m')
else
    B=""; D=""; G=""; Y=""; R=""; N=""
fi
say()  { printf '%s\n' "$*"; }
step() { printf '%s→%s %s\n' "$D" "$N" "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*"; }
die()  { printf '%s✗%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

usage() {
    # the header comment is the help text: keep one copy of the truth
    if command -v sed >/dev/null 2>&1; then
        sed -n '2,33p' "$self" | sed 's/^# \{0,1\}//'
    else
        printf '%s\n' "local-file-sharer: cd into the checkout and run ./run"
    fi
    exit 0
}

# ── 1. find a Python that can build a venv ──────────────────────────────────
find_python() {
    for candidate in python3 python; do
        if command -v "$candidate" >/dev/null 2>&1; then
            if "$candidate" -c 'import sys, venv; sys.exit(0 if sys.version_info >= (3, 9) else 1)' \
                >/dev/null 2>&1; then
                printf '%s' "$candidate"
                return 0
            fi
        fi
    done
    return 1
}

need_python() {
    if py=$(find_python); then
        return 0
    fi
    printf '\n' >&2
    die "no Python 3.9+ with venv support found.
  Termux : pkg install python
  Debian : sudo apt install python3 python3-venv
  Fedora : sudo dnf install python3
  macOS  : brew install python3   (or install the Xcode command line tools)"
}

# ── 2. set up the virtualenv ────────────────────────────────────────────────
# Is there a working pip inside the venv? An interrupted or failed venv leaves
# .venv/bin/python behind with no pip, and reusing that fails later with the
# unhelpful "No module named pip".
venv_has_pip() {
    [ -x "$PY" ] && "$PY" -m pip --version >/dev/null 2>&1
}

# The venv module without ensurepip: Termux ships pip as a separate package and
# has no ensurepip at all, so `python -m venv` makes a venv that cannot install
# anything. --without-pip is what works there.
venv_without_ensurepip() {
    "$py" -c 'import sys, venv, ensurepip' >"$SCRATCH"/venv-probe 2>&1
}

# Last resort: pip runs, but only from outside the venv.
bootstrap_pip() {
    step "repairing pip inside .venv"
    if "$PY" -m ensurepip --upgrade >"$SCRATCH"/bootstrap 2>&1; then
        return 0
    fi
    if [ -f "$py_home/get-pip.py" ]; then
        if "$PY" "$py_home/get-pip.py" --quiet >"$SCRATCH"/bootstrap 2>&1; then
            return 0
        fi
    fi
    return 1
}

make_venv() {
    if venv_without_ensurepip; then
        "$py" -m venv "$VENV" >"$SCRATCH"/venv-out 2>&1
        return $?
    fi
    # No ensurepip. If this Python has pip, borrow it: --system-site-packages
    # lets the venv import the system pip and install into the venv itself.
    if "$py" -m pip --version >/dev/null 2>&1; then
        warn "this Python has no ensurepip — borrowing its pip instead"
        rm -rf "$VENV"
        "$py" -m venv --without-pip --system-site-packages "$VENV" >"$SCRATCH"/venv-out 2>&1 \
            && [ -x "$PY" ] && return 0
    fi
    "$py" -m venv --without-pip "$VENV" >"$SCRATCH"/venv-out 2>&1
}

setup() {
    need_python
    py_home=$("$py" -c 'import sysconfig; print(sysconfig.get_path("stdlib"))' 2>/dev/null || echo "")

    # A venv that cannot pip is not a venv. Remake it rather than failing in a
    # later step with "No module named pip".
    if [ -d "$VENV" ] && ! venv_has_pip; then
        warn "found a broken .venv (no pip) — recreating it"
        rm -rf "$VENV"
    fi

    if [ ! -x "$PY" ]; then
        step "creating .venv with $("$py" --version 2>&1)"
        if ! make_venv; then
            msg=$(cat "$SCRATCH"/venv-out 2>/dev/null || true)
            rm -f "$SCRATCH"/venv-out "$SCRATCH"/venv-probe
            case "$msg" in
                *ensurepip*|*python3-venv*|*"No module named venv"*)
                    die "this Python cannot create a virtualenv.
  Termux  : pkg install python          (includes venv and pip)
  Debian  : sudo apt install python3-venv
  Fedora  : sudo dnf install python3
  macOS   : brew install python3" ;;
                *"No module named pip"*)
                    die "the virtualenv was created without pip.
  Termux  : pkg install python          (provides pip)
  Debian  : sudo apt install python3-venv python3-pip" ;;
                *)
                    die "could not create .venv
$msg" ;;
            esac
        fi
        rm -f "$SCRATCH"/venv-out "$SCRATCH"/venv-probe
        ok "created .venv"
    fi

    # Still no pip after all that (a venv made earlier by another tool, or a
    # broken one we could not see). Fix it here, where the message is honest.
    if ! venv_has_pip; then
        if ! bootstrap_pip; then
            msg=$(cat "$SCRATCH"/bootstrap 2>/dev/null || true)
            rm -f "$SCRATCH"/bootstrap
            {
                printf '%s\n' "the virtualenv has no pip and it could not be repaired."
                printf '%s\n' "$msg"
                printf '%s\n' "  Termux  : pkg install python"
                printf '%s\n' "  then    : rm -rf .venv && ./run"
            } >&2
            exit 1
        fi
        rm -f "$SCRATCH"/bootstrap
        ok "pip repaired"
    fi

    # Editable install, so `git pull` is the whole upgrade path. Re-run only
    # when something actually changed: a fresh checkout, or a commit that
    # touched the packaging metadata.
    stamp="$VENV/.lfs-stamp"
    want=$(git -C "$HERE" rev-parse --short HEAD 2>/dev/null || echo "nogit")
    if [ -x "$LFS" ] && [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$want" ]; then
        return 0
    fi

    step "installing dependencies (rich, qrcode)"
    "$PY" -m pip install --quiet --upgrade pip >/dev/null 2>&1 || true
    if ! "$PY" -m pip install --quiet --editable "$HERE" 2>"$SCRATCH"/pip-error; then
        msg=$(cat "$SCRATCH"/pip-error 2>/dev/null || true)
        rm -f "$SCRATCH"/pip-error
        case "$msg" in
            *"Could not find a version"*|*"Temporary failure"*|*"Name or service"*)
                die "cannot reach PyPI — check the connection and run ./run again" ;;
        esac
        printf '%s\n' "$msg" >&2
        die "install failed (full output above)"
    fi
    rm -f "$SCRATCH"/pip-error
    printf '%s' "$want" > "$stamp"
    ok "installed $("$PY" -c 'import local_file_sharer as m; print(m.__version__)')"
}

# ── 3. dispatch ─────────────────────────────────────────────────────────────
case "${1:-}" in
    -h|--help|help) usage ;;
    setup)    setup; say ""; ok "ready — run ./run"; exit 0 ;;
    upgrade)
        setup
        # This directory may be a git clone, or a copy unpacked by
        # install-lfs.py. Only the first can `git pull`; the second used to hit
        # "not a git repository" and die, which made the documented upgrade
        # path impossible for anyone who used the installer.
        if [ -d "$HERE/.git" ]; then
            step "pulling $BRANCH"
            git -C "$HERE" pull --ff-only || die "git pull failed — resolve it, then run ./run"
            rm -f "$VENV/.lfs-stamp"
            setup
            ok "upgraded — run ./run"
            exit 0
        fi
        # No history to pull. All that has to change is the package itself, so
        # reinstall it in place: pip fetches the same branch, and because the
        # install is editable the code that runs is the code just fetched.
        step "this copy was not cloned with git, so there is nothing to pull"
        step "reinstalling from $BRANCH instead"
        "$PY" -m pip install --quiet --upgrade --force-reinstall --no-deps \
            "local-file-sharer @ git+https://github.com/$OWNER/$REPO.git@$BRANCH" \
            2>"$SCRATCH"/upgrade-error || {
                msg=$(cat "$SCRATCH"/upgrade-error 2>/dev/null || true)
                rm -f "$SCRATCH"/upgrade-error
                printf '%s\n' "$msg" >&2
                die "upgrade failed — see above. Nothing was changed."
            }
        rm -f "$SCRATCH"/upgrade-error
        ok "upgraded — run ./run"
        exit 0 ;;
    doctor)   setup; exec "$LFS" doctor ;;
    "")       setup; exec "$LFS" ;;
    *)        setup; exec "$LFS" "$@" ;;
esac
